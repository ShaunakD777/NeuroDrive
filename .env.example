# NeuroDrive environment variables — placeholders only.
#
# NeuroDrive currently needs NO secrets. This file documents the pattern for the future:
#   1. Copy it to `.env` (which git ignores) and fill in real values there.
#   2. Every variable is prefixed ND_ and is read from the environment, never from configs.
#   3. Never put a real value in this file.
#
# Optional, non-secret settings:
ND_SERVER_PORT=8000
ND_RUNS_DIR=runs
