{
  "name": "neurodrive-2d-redesign-prototype",
  "version": "0.1.0",
  "description": "Isolated visual and UX design prototype for NeuroDrive. Not part of the production app: static recorded data, no Python server.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "screenshots": "node scripts/screenshots.mjs",
    "capture": "node scripts/capture-mock-data.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "@fontsource/ibm-plex-sans": "^5.0.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
