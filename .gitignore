# ── Secrets and local environment (never commit) ─────────────
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
secrets/
credentials*.json
*.token

# ── NeuroDrive outputs (regenerable, can be large) ──────────
runs/
data/
recordings/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.npz
